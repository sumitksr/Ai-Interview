// MongoDB connection URI
MONGO_URI=

// Secret key for JWT signing
JWT_SECRET=

// Email configuration
MAIL_HOST=
MAIL_PASS=
MAIL_PORT=
MAIL_USER=

// Number of rounds for bcrypt hashing
N=

// Cloudinary configuration for image hosting
CLOUDINARY_API_ENV=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

// NextAuth config
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

// GitHub OAuth credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

// Google OAuth credentials (used for NextAuth login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

// Google Calendar API — auto-generates Google Meet links at booking time
// Run: node scripts/get-google-token.mjs  to obtain your refresh token
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

// OpenAI API key
OPENAI_API_KEY=

// Gemini API key
GEMINI_API_KEY=

// Razorpay payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
